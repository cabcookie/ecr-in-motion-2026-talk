{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "aws-cdk-lib": [
        "../../packages/infra/node_modules/aws-cdk-lib"
      ],
      "aws-cdk-lib/*": [
        "../../packages/infra/node_modules/aws-cdk-lib/*"
      ],
      "constructs": [
        "../../packages/infra/node_modules/constructs"
      ]
    },
    "typeRoots": [
      "../../packages/infra/node_modules/@types"
    ]
  },
  "include": [
    "*.ts"
  ]
}
