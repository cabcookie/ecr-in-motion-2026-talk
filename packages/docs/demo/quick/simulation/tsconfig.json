{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "packages/db/src/**/*",
    "packages/shared/src/**/*",
    "packages/agents/src/**/*",
    "packages/mcp-outlook/src/**/*",
    "packages/mcp-teams/src/**/*",
    "packages/mcp-sap/src/**/*",
    "packages/mcp-wms/src/**/*",
    "packages/api/src/**/*",
    "packages/api/tests/**/*"
  ],
  "exclude": ["node_modules", "dist", "packages/frontend"]
}
